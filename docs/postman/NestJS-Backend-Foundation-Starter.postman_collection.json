    {
      "name": "Google Auth",
      "description": "Google OAuth redirect flow under `/v1/auth/google`. Prefer a browser for the real SSO round-trip; these requests document the inventory.",
      "item": [
        {
          "name": "Google SSO start",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/google?returnUrl={{returnUrl}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "google"
              ],
              "query": [
                {
                  "key": "returnUrl",
                  "value": "{{returnUrl}}"
                }
              ]
            },
            "description": "Starts Google SSO (302 redirect when enabled). Optional `returnUrl` query."
          },
          "response": []
        },
        {
          "name": "Google SSO callback",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/google/callback?code={{googleAuthCode}}&state={{googleAuthState}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "google",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{googleAuthCode}}"
                },
                {
                  "key": "state",
                  "value": "{{googleAuthState}}"
                }
              ]
            },
            "description": "OAuth callback placeholders only — not a secret store. Browser redirect flow."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sessions",
      "description": "Session management under `/v1/sessions`. Available only when `AUTH_DRIVER=session`. Requires Cookie `{{sessionCookieName}}={{sessionCookieValue}}`.",
      "item": [
        {
          "name": "List sessions",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookieName}}={{sessionCookieValue}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sessions"
              ]
            },
            "description": "List sessions for the current cookie session."
          },
          "response": []
        },
        {
          "name": "Revoke other sessions",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookieName}}={{sessionCookieValue}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions/others",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sessions",
                "others"
              ]
            },
            "description": "Revoke all sessions except the current one."
          },
          "response": []
        },
        {
          "name": "Revoke all / current sessions",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookieName}}={{sessionCookieValue}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sessions"
              ]
            },
            "description": "Revoke sessions for the current user and clear the cookie."
          },
          "response": []
        },
        {
          "name": "Revoke session by id",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookieName}}={{sessionCookieValue}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "description": "Revoke a single session by UUID (`{{sessionId}}`). OpenAPI path param is `{id}`."
          },
          "response": []
        }
      ]
    },
